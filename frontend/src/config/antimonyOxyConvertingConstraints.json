  "customConstraints": [
    {
      "expr": "Input.加料口漏风 / 5000",
      "target": 1,
      "relativeTolerance": 0.005
    },
    {
      "expr": "((Input.空气.O2 + Input.氧气.O2) / 32 * 22.4) / (Input.空气 + Input.氧气)",
      "target": 0.3,
      "relativeTolerance": 0.005
    },
    {
      "expr": "(OutputE.吹炼渣.Ca / Ca * CaO) / OutputE.吹炼渣.Fe",
      "target": 0.4,
      "relativeTolerance": 0.005
    },
    {
      "expr": "Output.吹炼烟气含尘.Cu2S / Output.吹炼烟气含尘.Cu2O",
      "target": 0.1,
      "relativeTolerance": 0.005
    },
    {
      "expr": "Output.吹炼烟气含尘.Fe3O4.Fe / OutputE.吹炼烟气含尘.Fe",
      "target": 0.015,
      "relativeTolerance": 0.005
    },
    {
      "expr": "Output.吹炼出炉烟气.As2O3.As / (Output.吹炼出炉烟气.As2O3.As + Output.吹炼烟气含尘.As2O3.As)",
      "target": 0.6,
      "relativeTolerance": 0.005
    },
    {
      "expr": "(Input.空气.O2 + Input.氧气.O2 + Input.加料口漏风.O2) / ((Input.空气.O2 + Input.氧气.O2 + Input.加料口漏风.O2) - Output.吹炼出炉烟气.O2)",
      "target": 1.15,
      "relativeTolerance": 0.005
    }
  ],
  "solverParams": {
    "wPercentIterations": 40,
    "newtonMaxIterations": 100,
    "tolerance": 0.0001,
    "constraintRelativeTolerance": 0.005
