  "customConstraints": [
    {
      "expr": "Input.煤 / Input.混合锑精矿",
      "target": 0.0330474820760344,
      "relativeTolerance": 0.005,
      "note": "由 Excel 工况反推：无烟煤 0.1652374104 t/h ÷ 锑精矿湿基 5 t/h。"
    },
    {
      "expr": "((Input.空气.O2 + Input.氧气.O2) / 32 * 22.4) / (Input.空气 + Input.氧气)",
      "target": 0.3,
      "relativeTolerance": 0.005,
      "note": "Excel 富氧空气为 O2/N2=30/70 vol%。"
    },
    {
      "expr": "Output.烟气.O2 / Output.烟气",
      "target": 0.046413906109439,
      "relativeTolerance": 0.01,
      "note": "Excel 烟气 O2=4.64139061 wt%（对应 5 vol%）。"
    },
    {
      "expr": "OutputE.熔炼渣.Fe / (OutputE.熔炼渣.Si / Si * SiO2)",
      "target": 1.010461956,
      "relativeTolerance": 0.01,
      "note": "由 Excel 熔炼渣 Fe=21.79256952 wt%、SiO2=21.56603229 wt% 反推。"
    },
    {
      "expr": "(OutputE.熔炼渣.Ca / Ca * CaO) / (OutputE.熔炼渣.Si / Si * SiO2)",
      "target": 0.5,
      "relativeTolerance": 0.01,
      "note": "由 Excel 熔炼渣 CaO=10.78301614 wt%、SiO2=21.56603229 wt% 反推。"
    },
    {
      "expr": "OutputE.锑锍.S / (0.265413629241361 * Output.锑锍)",
      "target": 1,
      "soft": true,
      "relativeTolerance": 0.02,
      "note": "Excel 锑锍 S=26.54136292 wt%。"
    },
    {
      "expr": "OutputE.锑锍.Fe / (0.419059112179791 * Output.锑锍)",
      "target": 1,
      "soft": true,
      "relativeTolerance": 0.02,
      "note": "Excel 锑锍 Fe=41.90591122 wt%。"
    },
    {
      "expr": "Output.锑氧粉.Sb2O3 / Output.锑氧粉",
      "target": 0.894255351209323,
      "soft": true,
      "relativeTolerance": 0.02,
      "note": "Excel 锑氧粉 Sb2O3=89.42553512 wt%。"
    },
    {
      "expr": "OutputE.贵锑.Sb / Output.贵锑",
      "target": 0.8922,
      "soft": true,
      "relativeTolerance": 0.02,
      "note": "Excel 贵锑 Sb=89.22 wt%。"
    }
  ],
